# Backend-only secrets: use two DISTINCT usable keys. Never use VITE_ for secrets.
LLM_API_KEYS=replace-with-first-key,replace-with-second-key
# Verify this model is available to both of your keys before deployment.
LLM_MODEL=gemini/gemini-2.5-flash-lite
# Optional base URL for OpenAI-compatible providers; leave blank for Gemini.
LLM_API_BASE=
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant. Keep simple factual answers to 1-3 sentences. Expand only when the user asks for detail or the task requires it. Use Markdown when useful."
LLM_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=86400
PORT=8000

# Public, build-time frontend config. Rebuild the frontend after changing it.
VITE_API_BASE_URL=http://localhost:8000

# Live verification script only; change to your public HTTPS backend when deploying.
LYFTR_API_URL=http://localhost:8000

# Public VM HTTPS deployment (AWS or Oracle); use a hostname and ACME contact email.
BACKEND_HOST=replace-with-your-backend-hostname
ACME_EMAIL=replace-with-your-email
